interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls } = Astro.props;
const d = icons[name] ?? "";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={d}
/>
