{
  // Cloudflare Workers static assets, built by Workers Builds on every push.
  // Dashboard, Settings > Build: build command `pnpm build`, preview command
  // its default `npx wrangler preview`. Rename `name` to match the Worker.
  "name": "sutando-org",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    // Every page is `<route>/index.html` and Blume's canonical tags, sitemap and
    // internal links all point at `/route`. The default (auto-trailing-slash)
    // would 308 each of those to `/route/`, leaving the served URL and the
    // canonical disagreeing; this serves them as written.
    "html_handling": "drop-trailing-slash",
    // Serve Blume's dist/404.html instead of a bare Cloudflare 404.
    "not_found_handling": "404-page"
  },
  // A branch build runs `npx wrangler preview`, which refuses to run without
  // this block ("Your Wrangler configuration is missing a `previews` block").
  // It can be empty: a static build has no vars, secrets or bindings to point
  // at preview-safe resources. Production settings stay at the top level, and
  // `wrangler deploy` ignores this block.
  "previews": {},
  "build": {
    "command": "pnpm build"
  }
}
